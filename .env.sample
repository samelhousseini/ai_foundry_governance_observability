AZURE_AI_CONTENT_SAFETY_URL="https://<content-safety-resource>.cognitiveservices.azure.com/"
AZURE_AI_CONTENT_SAFETY_KEY="<content-safety-key>"

AZURE_OPENAI_ENDPOINT="https://<openai-resource>.openai.azure.com/"
AZURE_OPENAI_API_KEY="<openai-api-key>"
AZURE_OPENAI_MODEL_NAME="<openai-model-name>"

ENABLE_OTEL=true
ENABLE_SENSITIVE_DATA=true
OTLP_ENDPOINT=http://<collector-host>:4317
APPLICATIONINSIGHTS_CONNECTION_STRING="InstrumentationKey=<instrumentation-key>;IngestionEndpoint=https://<region>.in.applicationinsights.azure.com/;LiveEndpoint=https://<region>.livediagnostics.monitor.azure.com/;ApplicationId=<application-id>"
VS_CODE_EXTENSION_PORT=4317

AZURE_AI_PROJECT_ENDPOINT="https://<project-endpoint>"
AZURE_AI_MODEL_DEPLOYMENT_NAME="<model-deployment-name>"
